using System;

namespace Calculator
{
    class Program
    {
        static void Main(string[] args)
        {
            if (args.Length != 3)
            {
                Console.WriteLine("Usage: Calculator <num1> <operator> <num2>");
                return;
            }

            double num1 = double.Parse(args[0]);
            char operatorChar = char.Parse(args[1]);
            double num2 = double.Parse(args[2]);

            double result = 0;

            switch (operatorChar)
            {
                case '+':
                    result = num1 + num2;
                    break;
                case '-':
                    result = num1 - num2;
                    break;
                case '*':
                    result = num1 * num2;
                    break;
                case '/':
                    if (num2 == 0)
                    {
                        Console.WriteLine("Error: cannot divide by zero!");
                        return;
                    }
                    result = num1 / num2;
                    break;
                default:
                    Console.WriteLine("Error: unknown operator!");
                    return;
            }

            Console.WriteLine($"Result: {result}");
        }
    }
}
